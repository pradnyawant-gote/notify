{
  "name": "dayflow",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "decode-uri-component": "0.5.0",
    "postcss-selector-parser": "7.1.6",
    "uuid": "11.1.1"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.cjs",
    "export:web": "expo export --platform web",
    "preview": "node scripts/preview.cjs",
    "format": "prettier --write app src tests scripts docs *.json *.js *.css"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.0",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/slot": "^1.2.0",
    "@rn-primitives/switch": "^1.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.52.0",
    "moti": "^0.30.0",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  },
  "allowScripts": {
    "@shopify/react-native-skia@2.6.2": true,
    "esbuild@0.28.2": true
